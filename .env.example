# -----------------------------------------------------------------------
# DICOM HTJ2K Compression Middleware – environment configuration
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------

# ---- DICOMweb proxy listener ----
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
PROXY_BASE_PATH=/wado-rs

# ---- DIMSE C-STORE SCP listener ----
DIMSE_HOST=0.0.0.0
DIMSE_PORT=11112
DIMSE_AE_TITLE=HTJ2K_PROXY

# ---- Cloud PACs target (required) ----
# Base URL of the cloud PACs DICOMweb endpoint
CLOUD_PACS_URL=https://pacs.example.com/wado

# Cloud PACs authentication scheme: none | basic | bearer | oauth2
CLOUD_PACS_AUTH_SCHEME=none

# Basic auth
# CLOUD_PACS_USERNAME=myuser
# CLOUD_PACS_PASSWORD=mypassword

# Bearer token
# CLOUD_PACS_TOKEN=eyJhbGciOiJSUzI1...

# OAuth2 client-credentials
# CLOUD_PACS_OAUTH2_TOKEN_URL=https://auth.example.com/oauth2/token
# CLOUD_PACS_OAUTH2_CLIENT_ID=my-client-id
# CLOUD_PACS_OAUTH2_CLIENT_SECRET=my-client-secret

# ---- HTJ2K compression options ----
# Mode: lossless | lossless_rpcl | lossy
HTJK2_MODE=lossless
# For lossy mode – peak SNR target in dB (1–1000)
HTJ2K_LOSSY_QUALITY=40.0
# CPU threads for compression (0 = use all available cores)
HTJ2K_NUM_THREADS=0

# ---- HTTP client tuning ----
HTTP_TIMEOUT_SECONDS=120.0
HTTP_MAX_RETRIES=3
