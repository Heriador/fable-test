# -----------------------------------------------------------------------
# DCM4CHEE MCP server - environment configuration
# Copy this file to .env and fill in your values.
# All variables are prefixed with DCM4CHEE_.
# -----------------------------------------------------------------------

# ---- dcm4chee-arc REST API ----
# Base URL of the archive UI/REST root (no trailing slash)
DCM4CHEE_BASE_URL=http://localhost:8080/dcm4chee-arc
# Archive AE title (default AE of the archive device)
DCM4CHEE_AET=DCM4CHEE
DCM4CHEE_HTTP_TIMEOUT_SECONDS=30.0

# ---- Keycloak (only for SECURED deployments; leave commented for the
#      default unsecured docker deployment) ----
# DCM4CHEE_KEYCLOAK_TOKEN_URL=https://localhost:8843/realms/dcm4che/protocol/openid-connect/token
# DCM4CHEE_KEYCLOAK_CLIENT_ID=dcm4chee-arc-rs
# DCM4CHEE_KEYCLOAK_CLIENT_SECRET=changeit
# DCM4CHEE_KEYCLOAK_VERIFY_TLS=true

# ---- Log access ----
# Host path of the WildFly server.log. With the standard docker-compose
# deployment this is the volume mounted at /opt/wildfly/standalone/log
# inside the container, e.g.:
DCM4CHEE_LOG_FILE_PATH=/var/local/dcm4chee-arc/wildfly/standalone/log/server.log
# Optional fallback: read logs via `docker logs <container>` when the file
# is not directly readable (requires this process to have docker access).
# DCM4CHEE_DOCKER_CONTAINER=dcm4chee-arc
# Maximum number of log lines any tool will return
DCM4CHEE_MAX_LOG_LINES=500
